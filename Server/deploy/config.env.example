# Copy to config.env (gitignored) and edit. Sourced by every script in this directory.
# Anything left unset falls back to the default shown here.

# ---- AWS target -------------------------------------------------------------
# Named CLI profile. Leave empty to use the default credential chain / env vars.
AWS_PROFILE=
AWS_REGION=ap-northeast-2
# Optional safety net: abort if the caller is not in this account (12 digits).
EXPECTED_ACCOUNT_ID=
# Space separated profile names or globs that always require typing the account id to confirm
# (and `--yes --account-id <id>` when non-interactive). Default: any profile with "prod" in its name.
STRICT_PROFILES="*prod* *production*"

# ---- naming -----------------------------------------------------------------
PROJECT=fps
ALIAS_NAME=fps-server            # the alias name is how scripts find "the current fleet"
BACKEND_STACK=fps-backend
WEB_STACK=fps-web
BUDGET_STACK=fps-budget
# Artifacts bucket for the Lambda zip. Default: ${PROJECT}-artifacts-<account>-<region>
ARTIFACT_BUCKET=

# ---- GameLift fleet ---------------------------------------------------------
EC2_INSTANCE_TYPE=c6i.large
SERVER_SDK_VERSION=5.5.1
SERVER_LAUNCH_PATH=/local/game/FPSServer.x86_64
SERVER_BASE_PORT=7770            # processes use BASE_PORT .. BASE_PORT+COUNT-1
SERVER_PROCESS_COUNT=4           # 1 game session per process => 4 rooms per instance

# ---- capacity (hard cap = MAX x PROCESS_COUNT rooms x MAX_PLAYERS players) ---
CAPACITY_MIN=0
CAPACITY_MAX=2
CAPACITY_DESIRED=1
# set-capacity.sh refuses MAX above this. Raise it here on purpose to lift the cap.
MAX_INSTANCES_LIMIT=2
SCALING_TARGET_PERCENT_AVAILABLE=25

# ---- backend ----------------------------------------------------------------
MAX_PLAYERS=8
# Extra CORS origins (comma separated). The CloudFront URL of the web stack is
# appended automatically when that stack exists.
ALLOWED_ORIGINS=http://localhost:8080
# Optional GameLift location (Region code); empty = fleet home Region
LOCATION=

# ---- budget -----------------------------------------------------------------
BUDGET_AMOUNT=50
BUDGET_EMAIL=
